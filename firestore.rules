rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function own(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn() && (
        (
          exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
        ) || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' &&
          (
            !('is_active' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_active == true
          )
        )
      );
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function householdMember(householdId) {
      return signedIn() && userData().householdId == householdId &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }
    function motherOf(householdId) {
      return householdMember(householdId) &&
        get(/databases/$(database)/documents/households/$(householdId)).data.motherId == request.auth.uid;
    }
    function partnerOf(householdId) {
      return householdMember(householdId) &&
        get(/databases/$(database)/documents/households/$(householdId)).data.partnerId == request.auth.uid;
    }
    function sameHousehold(profile) {
      return signedIn() && profile.householdId != null &&
        userData().householdId == profile.householdId;
    }
    function validPartnerLink(uid) {
      let householdId = request.resource.data.householdId;
      return resource.data.householdId == null &&
        request.resource.data.role == 'partner' &&
        getAfter(/databases/$(database)/documents/households/$(householdId)).data.partnerId == uid &&
        uid in getAfter(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }
    function validLegacyMigration(uid) {
      let householdId = request.resource.data.householdId;
      return resource.data.householdId == null &&
        request.resource.data.role == 'mother' &&
        getAfter(/databases/$(database)/documents/households/$(householdId)).data.motherId == uid &&
        getAfter(/databases/$(database)/documents/households/$(householdId)).data.memberIds == [uid];
    }

    match /users/{uid} {
      allow create: if own(uid) &&
        request.resource.data.role in ['mother', 'partner'];
      allow read: if isAdmin() || own(uid) || sameHousehold(resource.data);
      allow delete: if own(uid);
      allow update: if own(uid) && (
        request.resource.data.householdId == resource.data.householdId ||
        validPartnerLink(uid) || validLegacyMigration(uid)
      );
      match /{privateDocument=**} {
        allow read, write: if own(uid);
      }
    }

    match /households/{householdId} {
      allow create: if signedIn() &&
        request.resource.data.motherId == request.auth.uid &&
        request.resource.data.memberIds == [request.auth.uid];
      allow read: if isAdmin() || householdMember(householdId);
      allow update: if (
        motherOf(householdId) &&
        request.resource.data.memberIds == resource.data.memberIds &&
        request.resource.data.partnerId == resource.data.partnerId
      ) || (
        signedIn() && resource.data.partnerId == null &&
        resource.data.inviteCode is string &&
        request.resource.data.partnerId == request.auth.uid &&
        request.resource.data.memberIds.hasAll(resource.data.memberIds) &&
        request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1 &&
        request.auth.uid in request.resource.data.memberIds &&
        getAfter(/databases/$(database)/documents/partnerInvites/$(resource.data.inviteCode)).data.status == 'accepted' &&
        getAfter(/databases/$(database)/documents/partnerInvites/$(resource.data.inviteCode)).data.partnerId == request.auth.uid
      );
      allow delete: if motherOf(householdId);

      match /tasks/{taskId} {
        allow read: if householdMember(householdId);
        allow create: if motherOf(householdId) &&
          request.resource.data.keys().hasOnly(['title', 'completed', 'createdBy', 'createdAt']) &&
          request.resource.data.title is string &&
          request.resource.data.title.size() > 0 &&
          request.resource.data.title.size() <= 200 &&
          request.resource.data.completed == false &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time;
        allow update: if partnerOf(householdId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['completed', 'completedBy', 'completedAt']) &&
          (
            (
              request.resource.data.completed == true &&
              request.resource.data.completedBy == request.auth.uid &&
              request.resource.data.completedAt == request.time
            ) || (
              request.resource.data.completed == false &&
              request.resource.data.completedBy == null &&
              request.resource.data.completedAt == null
            )
          );
        allow delete: if motherOf(householdId);
      }
      match /messages/{messageId} {
        allow read: if householdMember(householdId);
        allow create: if householdMember(householdId) &&
          request.resource.data.senderId == request.auth.uid;
        allow update, delete: if householdMember(householdId) &&
          resource.data.senderId == request.auth.uid;
      }
      match /healthLogs/{logId} {
        allow read: if householdMember(householdId);
        allow write: if motherOf(householdId);
      }
      match /kickSessions/{sessionId} {
        allow read: if householdMember(householdId);
        allow write: if motherOf(householdId);
      }
      match /events/{eventId} {
        allow read, write: if householdMember(householdId);
      }
      match /emergencyContacts/{contactId} {
        allow read: if householdMember(householdId);
        allow write: if motherOf(householdId);
      }
      match /sosAlerts/{alertId} {
        allow read: if householdMember(householdId);
        allow create: if motherOf(householdId) &&
          request.resource.data.triggeredBy == request.auth.uid &&
          request.resource.data.status == 'active';
        allow update: if householdMember(householdId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'resolvedAt']) &&
          request.resource.data.status == 'resolved';
      }
    }

    match /partnerInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() &&
        request.resource.data.motherId == request.auth.uid &&
        motherOf(request.resource.data.householdId) &&
        request.resource.data.status == 'pending';
      allow update: if signedIn() && resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        request.resource.data.partnerId == request.auth.uid &&
        getAfter(/databases/$(database)/documents/households/$(resource.data.householdId)).data.partnerId == request.auth.uid;
      allow delete: if signedIn() && resource.data.motherId == request.auth.uid;
    }

    match /posts/{postId} {
      allow get: if signedIn();
      allow list: if isAdmin() ||
        (signedIn() && request.query.limit <= 50);
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn() && resource.data.authorId == request.auth.uid;
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.authorId == request.auth.uid);

      match /likes/{uid} {
        allow get: if signedIn();
        allow list: if isAdmin() ||
          (signedIn() && request.query.limit <= 500);
        allow create: if own(uid) && request.resource.data.userId == request.auth.uid;
        allow delete: if isAdmin() || own(uid);
        allow update: if false;
      }

      match /replies/{replyId} {
        allow get: if signedIn();
        allow list: if isAdmin() ||
          (signedIn() && request.query.limit <= 500);
        allow create: if signedIn() &&
          request.resource.data.authorId == request.auth.uid &&
          request.resource.data.text is string &&
          request.resource.data.text.size() > 0 &&
          request.resource.data.text.size() <= 2000;
        allow update: if signedIn() && resource.data.authorId == request.auth.uid;
        allow delete: if isAdmin() ||
          (signedIn() && resource.data.authorId == request.auth.uid);
      }
    }

    match /admins/{uid} {
      allow get: if own(uid) || isAdmin();
      allow list: if isAdmin();
      allow write: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.adminId == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() >= 3 &&
        request.resource.data.reason.size() <= 300;
      allow update, delete: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
